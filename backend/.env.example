# 이 파일을 .env로 복사하세요. 실제 키는 Git/앱/채팅에 넣지 않습니다.
AI_MODE=mock
OPENAI_API_KEY=
TEXT_MODEL=gpt-6.1-terra
IMAGE_MODEL=gpt-image-2.6-flare
# 사용자별 이미지 생성 접수 한도(재시도 포함). 개발 중 30, 운영 시 예산에 맞게 조절.
IMAGE_REQUESTS_PER_HOUR=30
# backend 디렉터리에서 실행합니다. 다른 경로에 복사하면 절대 경로를 변경하세요.
DATA_DIR=C:/maeum-2nd/backend/storage
DATABASE_URL=sqlite:///C:/maeum-2nd/backend/storage/maeum-2nd.db

# Optional local emotion model. Score 0.7 does not mean measured accuracy of 70%.
EMOTION_URL=http://127.0.0.1:8001
EMOTION_TIMEOUT=8
EMOTION_MIN_CONFIDENCE=0.7
EMOTION_ART_HINT=1

